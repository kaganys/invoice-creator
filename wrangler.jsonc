{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bitz-designs-invoicing",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker/index.ts",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bitz-designs-invoicing",
			"database_id": "474f90b6-1196-4f66-b8d6-ef3ae5f85877",
			"remote": true,
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BRANDING",
			"bucket_name": "bitz-designs-branding",
			"remote": true
		}
	],
	"browser": {
		"binding": "BROWSER",
		"remote": true
	}
}